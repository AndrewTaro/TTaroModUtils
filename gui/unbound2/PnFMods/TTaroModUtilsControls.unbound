



(def element TT_SwitchOptionElement (_node:gfx) layout=true
	(scope
		(var key:str = "_node && _node.key ? _node.key : ''")
		(var defaultValue:bool = "_node.default ? _node.default : false")
		(macro TT_GET_SINGLE_PREF _varName="'prefData'" _key="key")
		(var prefValue:bool = "null != prefData && null != prefData.value ? prefData.value : defaultValue")
		(var isModified:bool = "prefValue != defaultValue")
		(var saveMethods:array  = "[{type: 'direct.action', name: 'mod.setPref',   args: [key, !prefValue]}]")
		(var resetMethods:array = "[{type: 'direct.action', name: 'mod.resetPref', args: [key]}]")
	)

	(style (width = "100%"))

	(hblock
		(style
			(width = "TT_CONFIG_OPTION_WIDTH")
			(height = "23px")
			(align = "left|middle")
		)
		(hblock
			(style
				(width = "TT_CONFIG_OPTION_CONTROL_WIDTH")
				(align = "middle|center")
				(marginRight = "TT_CONFIG_OPTION_VALUE_WIDTH + TT_CONFIG_OPTION_VALUE_MARGIN")
			)
			(element TT_Switch
				_state = "prefValue"
				_methods = "saveMethods"
			)
		)
		(controller $Instance renderer='TT_ImageButton'
			(bind enabled "isModified")
			(args
				_width = "TT_CONFIG_RESET_BUTTON_SIZE"
				_height = "TT_CONFIG_RESET_BUTTON_SIZE"
				_backgroundImage = 'url:../service_kit/buttons/context/update.png'
				_tooltipText = "'IDS_PREFERENCES_CONTEXT_PREF_RESET'"
				_methods = "resetMethods"
			)
		)
	)
)

(def element TT_SliderOptionElement (_node:gfx) layout=true
	(scope
		(var key:str = "_node && _node.key ? _node.key : ''")
		(var minValue:number = "_node.min ? _node.min : 0")
		(var maxValue:number = "null != _node.max ? _node.max : 10")
		(var minLabel:str = "_node.minLabel ? _node.minLabel : ''")
		(var maxLabel:str = "_node.maxLabel ? _node.maxLabel : ''")
		(var step:number = "null != _node.step ? _node.step : 1")
		(var default:number = "_node.default ? _node.default : 0")
		(var rounding:number = "null != _node.decimals ? _node.decimals : 2")
		(macro TT_GET_SINGLE_PREF _varName="'prefData'" _key="key")
		(var prefValue:number = "null != prefData && null != prefData.value ? prefData.value : default")

		(var prefIndex:number = "round((prefValue - minValue) / step)")
		(var isMinLabelAvailable:bool = "prefIndex == 0 && minLabel")
		(var isMaxLabelAvailable:bool = "prefIndex == round((maxValue - minValue) / step) && maxLabel")
		(var isModified:bool = "prefIndex != round((default - minValue) / step)")
		(var resetMethods:array = "[{type: 'direct.action', name: 'mod.resetPref', args: [key]}]")

		(var maxChars:number = "(maxValue >= 10000 ? 5 : maxValue >= 1000 ? 4 : maxValue >= 100 ? 3 : maxValue >= 10 ? 2 : 1)
								+ (rounding > 0 ? rounding + 1 : 0)
								+ (minValue < 0 ? 1 : 0)")
	)

	(style (width = "100%"))


	(hblock
		(style
			(width = "TT_CONFIG_OPTION_WIDTH")
			(height = "23px")
			(align = "left|middle")
		)
		(hblock
			(style
				(align = "middle|center")
			)
			(element TT_Slider
				_value = "prefValue"
				_min = "minValue"
				_max = "maxValue"
				_singleStep = "step"
				_decimals = "rounding"
				_width = "TT_CONFIG_OPTION_CONTROL_WIDTH"
				_track = "'TT_SliderTrackFill'"
				_writeAction = "'mod.setPref'"
				_writeArg0 = "key"
			)
			(block
				(style
					(marginRight = "TT_CONFIG_OPTION_VALUE_MARGIN")
					(width = "TT_CONFIG_OPTION_VALUE_WIDTH")
					(align = "middle|center")
				)
				(element TT_TextInputElement
					_value = "prefValue"
					_min = "minValue"
					_max = "maxValue"
					_step = "step"
					_decimals = "rounding"
					_maxChars = "maxChars"
					_height = "20"
					_fillWidth = "true"

					_minLabel = "minLabel"
					_maxLabel = "maxLabel"
					_atMin = "isMinLabelAvailable"
					_atMax = "isMaxLabelAvailable"
					_writeAction = "'mod.setPref'"
					_writeArg0 = "key"
				)
			)
		)
		(block
			(bind visible "isModified")
			(controller $Instance renderer='TT_ImageButton'
				(args
					_width = "TT_CONFIG_RESET_BUTTON_SIZE"
					_height = "TT_CONFIG_RESET_BUTTON_SIZE"
					_backgroundImage = 'url:../service_kit/buttons/context/update.png'
					_tooltipText = "'IDS_PREFERENCES_CONTEXT_PREF_RESET'"
					_methods = "resetMethods"
				)
			)
		)
	)
)

(def element TT_NumericInputOptionElement (_node:gfx) layout=true
	(scope
		(var key:str = "_node && _node.key ? _node.key : ''")
		(var minValue:number = "_node.min ? _node.min : 0")
		(var maxValue:number = "null != _node.max ? _node.max : 10")
		(var step:number = "null != _node.step ? _node.step : 1")
		(var decimals:number = "null != _node.decimals ? _node.decimals : 0")
		(var default:number = "_node.default ? _node.default : 0")

		(var maxChars:number = "(maxValue >= 10000 ? 5 : maxValue >= 1000 ? 4 : maxValue >= 100 ? 3 : maxValue >= 10 ? 2 : 1)
								+ (decimals > 0 ? decimals + 1 : 0)
								+ (minValue < 0 ? 1 : 0)")
		(macro TT_GET_SINGLE_PREF _varName="'prefData'" _key="key")
		(var prefValue:number = "null != prefData && null != prefData.value ? prefData.value : default")
		(var isModified:bool = "prefValue != default")
		(var resetMethods:array = "[{type: 'direct.action', name: 'mod.resetPref', args: [key]}]")
	)

	(style (width = "100%"))

	(hblock
		(style
			(width = "TT_CONFIG_OPTION_WIDTH")
			(align = "left|middle")
		)
		(block
			(style
				(width = "TT_CONFIG_OPTION_CONTROL_WIDTH")
				(align = "middle|center")
			)
			(element TT_TextInputElement
				_value = "prefValue"
				_min = "minValue"
				_max = "maxValue"
				_step = "step"
				_decimals = "decimals"
				_maxChars = "maxChars"

				_fillWidth = "true"
				_writeAction = "'mod.setPref'"
				_writeArg0 = "key"
			)
		)
		(block
			(style
				(marginRight = "TT_CONFIG_OPTION_VALUE_MARGIN")
				(width = "TT_CONFIG_OPTION_VALUE_WIDTH")
			)
		)
		(block
			(bind visible "isModified")
			(controller $Instance renderer='TT_ImageButton'
				(args
					_width = "TT_CONFIG_RESET_BUTTON_SIZE"
					_height = "TT_CONFIG_RESET_BUTTON_SIZE"
					_backgroundImage = 'url:../service_kit/buttons/context/update.png'
					_tooltipText = "'IDS_PREFERENCES_CONTEXT_PREF_RESET'"
					_methods = "resetMethods"
				)
			)
		)
	)
)


